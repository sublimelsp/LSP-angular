{
	"settings": {
		"angular.log": "off",
		"angular.enable-strict-mode-prompt": true,
		"angular.suggest.includeAutomaticOptionalChainCompletions": true,
		"angular.suggest.includeCompletionsWithSnippetText": true,
		"angular.suggest.autoImports": true,
		"angular.forceStrictTemplates": false,
		"angular.suppressAngularDiagnosticCodes": "",
		"angular.documentSymbols.enabled": true,
		"angular.documentSymbols.showImplicitForVariables": false,
		"angular.inlayHints.bindingHints.pipeOutputTypes": false,
		"angular.inlayHints.bindingHints.propertyBindingTypes": false,
		"angular.inlayHints.bindingHints.requiredInputIndicator": "none",
		"angular.inlayHints.bindingHints.twoWayBindingSignalTypes": false,
		"angular.inlayHints.controlFlowHints.deferTriggerTypes": false,
		"angular.inlayHints.controlFlowHints.switchExpressionTypes": false,
		"angular.inlayHints.eventHints.hostListenerArgumentTypes": false,
		"angular.inlayHints.eventHints.parameterTypes": false,
		"angular.inlayHints.functionTypes.arrowFunctionParameterTypes": false,
		"angular.inlayHints.functionTypes.arrowFunctionReturnTypes": false,
		"angular.inlayHints.interaction.interactiveInlayHints": false,
		"angular.inlayHints.parameterHints.nameHints": "all",
		"angular.inlayHints.parameterHints.suppressWhenArgumentMatchesName": true,
		"angular.inlayHints.variableTypes.forLoopVariableTypes": false,
		"angular.inlayHints.variableTypes.ifAliasTypes": false,
		"angular.inlayHints.variableTypes.letDeclarationTypes": false,
		"angular.inlayHints.variableTypes.referenceVariableTypes": false,
		"angular.inlayHints.variableTypes.suppressWhenTypeMatchesName": false,
		// Requires a file watcher package, e.g. LSP-file-watcher-rust.
		"angular.server.useClientSideFileWatcher": false
	},
	"env": {
		"TSC_NONPOLLING_WATCHER": "true"
	},
	// The path to the server binary used to start the language server.
	// Use `auto` for the package to manage (install/update) the server automatically.
	// NOTE: Change this instead of directly updating `command` - the `${server_path}` variable is dynamically resolved based on this setting.
	// WARNING: Override at your own risk - using a custom binary can cause compatibility issues with server settings.
	"server_path": "auto",
	"command": [
		"${node_bin}",
		"${server_path}",
		"--ngProbeLocations", "${server_directory_path}/node_modules",
		"--tsProbeLocations", "${server_directory_path}/node_modules",
		"--stdio"
	],
	"priority_selector": "source.ts meta.annotation string.quoted, source.js meta.annotation string.quoted",
	"selector": "text.html.ngx | source.ts | source.js",
}
